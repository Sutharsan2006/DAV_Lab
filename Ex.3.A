
#3.A
import pandas as pd
import numpy as np
from scipy.stats import skew, kurtosis

# Load datasets
uci_diabetes = pd.read_csv("uci_diabetes.csv")
pima_diabetes = pd.read_csv("pima_diabetes.csv")

# Display first 5 rows
print("UCI Diabetes Dataset")
print(uci_diabetes.head())

print("\nPima Diabetes Dataset")
print(pima_diabetes.head())

# Print column names
print("\nUCI Columns:")
print(uci_diabetes.columns.tolist())

print("\nPima Columns:")
print(pima_diabetes.columns.tolist())

# Numerical columns
numerical_columns = [
    "Glucose",
    "BloodPressure",
    "SkinThickness",
    "Insulin",
    "BMI",
    "DiabetesPedigreeFunction",
    "Age"
]

# Function for univariate analysis
def univariate_analysis(df, columns):

    result = []

    for col in columns:

        if col in df.columns:

            data = df[col].dropna()

            result.append({
                "Feature": col,
                "Mean": data.mean(),
                "Median": data.median(),
                "Mode": data.mode().iloc[0],
                "Variance": data.var(),
                "Standard Deviation": data.std(),
                "Skewness": skew(data),
                "Kurtosis": kurtosis(data)
            })

        else:
            print(f"Column '{col}' not found in dataset.")

    return pd.DataFrame(result)

# Perform analysis
uci_stats = univariate_analysis(uci_diabetes, numerical_columns)
pima_stats = univariate_analysis(pima_diabetes, numerical_columns)

# Display results
print("\nUCI Diabetes Statistics")
print(uci_stats)

print("\nPima Diabetes Statistics")
print(pima_stats)

